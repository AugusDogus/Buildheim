<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Environment.props" Condition="Exists('../Environment.props')" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <VALHEIM_MANAGED Condition="'$(VALHEIM_MANAGED)' == ''">$(VALHEIM_INSTALL)/valheim_Data/Managed</VALHEIM_MANAGED>
    <BEPINEX_PATH Condition="'$(BEPINEX_PATH)' == ''">$(VALHEIM_INSTALL)/BepInEx</BEPINEX_PATH>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="2.28.0" ExcludeAssets="build" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="$(VALHEIM_MANAGED)/assembly_valheim.dll" Publicize="true" Private="false" />
    <Reference Include="$(VALHEIM_MANAGED)/assembly_utils.dll" Private="false" />
    <Reference Include="$(VALHEIM_MANAGED)/UnityEngine*.dll" Private="false" />
    <Reference Include="$(BEPINEX_PATH)/core/BepInEx.dll" Private="false" />
    <Reference Include="$(BEPINEX_PATH)/core/0Harmony.dll" Private="false" />
    <Compile Include="PlanBuildPlugin.cs" />
    <Compile Include="Client/*.cs" />
    <Compile Include="Blueprints/PieceEntry.cs" />
    <Compile Include="Properties/AssemblyInfo.cs" />
    <Compile Include="Properties/IgnoreAccessModifiers.cs" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(VALHEIM_MANAGED)/assembly_valheim.dll')" Text="Valheim assemblies not found. Set VALHEIM_INSTALL to your Valheim directory." />
    <Error Condition="!Exists('$(BEPINEX_PATH)/core/BepInEx.dll')" Text="BepInEx assemblies not found. Set BEPINEX_PATH to your profile's BepInEx directory." />
  </Target>
</Project>
