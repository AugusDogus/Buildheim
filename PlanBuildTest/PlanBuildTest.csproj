<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Environment.props" Condition="Exists('../Environment.props')" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <VALHEIM_MANAGED Condition="'$(VALHEIM_MANAGED)' == ''">$(VALHEIM_INSTALL)/valheim_Data/Managed</VALHEIM_MANAGED>
    <BEPINEX_PATH Condition="'$(BEPINEX_PATH)' == ''">$(VALHEIM_INSTALL)/BepInEx</BEPINEX_PATH>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
    <!-- Only Jotunn's managed SimpleJson serializer runs in this .NET test host. -->
    <PackageReference Include="JotunnLib" Version="2.30.0" ExcludeAssets="all" GeneratePathProperty="true" />
    <Reference Include="$(PkgJotunnLib)/lib/net462/Jotunn.dll" />
    <Reference Include="$(VALHEIM_MANAGED)/UnityEngine.dll" />
    <Reference Include="$(VALHEIM_MANAGED)/UnityEngine.CoreModule.dll" />
    <Reference Include="$(VALHEIM_MANAGED)/assembly_utils.dll" />
    <Reference Include="$(VALHEIM_MANAGED)/assembly_valheim.dll" />
    <Reference Include="$(BEPINEX_PATH)/core/BepInEx.dll" />
    <Reference Include="$(BEPINEX_PATH)/core/Mono.Cecil.dll" />
    <Compile Include="../PlanBuild/Blueprints/PieceEntry.cs" Link="PieceEntry.cs" />
    <Compile Include="../PlanBuild/Client/BlueprintDocument.cs" Link="BlueprintDocument.cs" />
    <Compile Include="../PlanBuild/Client/BuildMaterials.cs" Link="BuildMaterials.cs" />
    <Compile Include="../PlanBuild/Client/AutoBuildQueue.cs" Link="AutoBuildQueue.cs" />
    <Compile Include="../PlanBuild/Client/BlueprintLayers.cs" Link="BlueprintLayers.cs" />
    <None Update="resources/*.blueprint" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
